interval_seconds: 60
spray_duration: 3

# Recording timeline per event: record pre_spray_seconds of video, fire the
# spray for spray_duration, then keep recording for post_spray_seconds. Total
# clip length = pre_spray_seconds + spray_duration + post_spray_seconds.
pre_spray_seconds: 3
post_spray_seconds: 4

gpio_pin: 17
relay_active_high: true

# Status LED on a separate GPIO pin (anode → pin, cathode → ground). The LED
# heartbeat-blinks every 10s while the service is running, blinks 1.5s when
# a frame is captured, and rapid-blinks 5 times on a positive bird detection.
status_led_enabled: true
status_led_pin: 24

# Manual trigger button (momentary switch contacts → pin + ground; uses the
# Pi's internal pull-up). While held, the status LED stays on. On release,
# the service runs the same flow as a real bird detection: capture frame,
# spray, record, upload.
trigger_button_enabled: true
trigger_button_pin: 23

capture_dir: ./captures

# Local-disk retention. The service deletes detection-*.jpg / event-*.mp4
# files older than this many days (mtime-based) once at startup and once per
# hour while running. Set to 0 (or any value <= 0) to disable cleanup and
# keep everything. R2 retention is handled separately via a bucket lifecycle
# rule (see "Remote publishing" in the README).
retention_days: 7

# Any OpenRouter model with vision support works here. Examples:
#   google/gemini-3-flash-preview        (default — best measured accuracy)
#   google/gemini-3.1-flash-lite-preview (similar accuracy, slower)
#   google/gemini-2.5-flash              (fallback)
# Note: anthropic/claude-haiku-4.5 and google/gemma-4-31b-it were measured at
# 0% recall on this camera's frames — they do not resolve small distant birds.
detector_model: google/gemini-3-flash-preview
detector_base_url: https://openrouter.ai/api/v1

# Longest-edge pixel cap applied to the frame before it is sent to the vision
# model. 0 disables downscaling and sends the frame at native resolution.
#
# Leave this at 0 unless upload bandwidth is a real constraint. Downscaling to
# 512 was measured to hurt BOTH ways on this camera: recall for
# gemini-3-flash-preview dropped 100% -> 67%, and gemini-2.5-flash went from 0
# to 5 false positives across 12 bird-free frames (it reads the white deck
# ornament as an animal once the detail is gone). It also saves nothing on
# token cost for the Gemini 3 models, which bill a fixed image token budget
# regardless of input size.
detector_max_image_dim: 0

# System prompt sent to the vision model. The model receives this plus a single
# image and is expected to reply with exactly "yes" or "no". Keep instructions
# short and unambiguous — long prompts cost more per call and don't necessarily
# improve accuracy. See the README "Tuning the prompt" section for guidance.
detector_prompt: |
  You are a bird detector for a backyard pool. Respond with exactly 'yes'
  if you see one or more birds in, on, or near the pool (including birds
  in flight directly above it). Respond with exactly 'no' otherwise.
  Output only the single word.

# Local frame-diff gate. The vision API is only called when the mean per-pixel
# delta between consecutive frames (downscaled grayscale) is >= threshold.
# Tune threshold up if wind/clouds/sun create false positives, down if small
# birds get missed. 0-255 scale; 5 is a reasonable starting point.
motion_enabled: true
motion_threshold: 5.0
motion_downscale: 320

# Only run detection inside the [daytime_start, daytime_end) window in local
# time. Default true to avoid burning API tokens on dark frames at night. Set
# false to run 24/7 (testing, or an IR camera that sees in the dark).
#
# Times must be quoted "HH:MM" strings — unquoted 07:00 is read as a number by
# YAML. A start later than the end wraps past midnight, e.g. "21:00"-"05:00"
# covers the night.
daytime_only: true
daytime_start: "07:00"
daytime_end: "19:00"

# Cloudflare R2 publishing (optional). When enabled, each detection's
# snapshot + event video are uploaded to a bucket so they're viewable
# from anywhere. Setup: create an R2 bucket, enable its public r2.dev
# subdomain, create an "Object Read & Write"-scoped API token, and put
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY into .env.
r2_enabled: false
r2_account_id: ""           # from R2 dashboard (the long hex string)
r2_bucket: ""               # bucket name, e.g. bird-away
r2_public_base_url: ""      # e.g. https://pub-<hash>.r2.dev
r2_key_prefix: events       # objects land at <prefix>/YYYY-MM-DD/<file>

# When true, do not keep local copies of captures: upload the JPEG straight
# from memory (no disk write at all) and delete the MP4 immediately after
# its R2 upload succeeds. Combine with capture_dir: /dev/shm/bird-away to
# eliminate SD-card writes entirely. Requires r2_enabled: true. See the
# README "Minimizing SD-card writes" section.
delete_after_upload: false

# Liveness ping to healthchecks.io (or any URL that accepts a GET). The
# service pings this URL after each successful loop iteration, rate-limited
# to once per healthcheck_interval_seconds. If the loop hangs or every
# iteration throws, pings stop and healthchecks.io alerts you. Sign up at
# https://healthchecks.io (free tier is fine), create a check, paste the
# unique ping URL here. Leave blank to disable.
healthcheck_url: ""
healthcheck_interval_seconds: 300

# Real-time monitoring (optional). When enabled, every periodic frame the loop
# captures — bird or not — is uploaded to a SEPARATE R2 prefix and indexed in
# its own manifest, so the dashboard's "Live" tab can show the last
# realtime_window_minutes of frames labeled detected / not-detected. This lets
# you eyeball false negatives (birds the detector missed). The events/ prefix
# stays real-detections-only. Requires r2_enabled: true.
#
# Frames go to <realtime_key_prefix>/frames/<ts>.jpg and the index lives at
# <realtime_key_prefix>/manifest.json. The dashboard only shows the last
# realtime_window_minutes; to stop paying for older frames, add an R2 bucket
# lifecycle rule that deletes objects under the "realtime/frames/" prefix after
# 1 day (R2's minimum granularity — see the README "Real-time monitoring"
# section). The manifest is excluded because it lives outside frames/.
realtime_enabled: false
realtime_key_prefix: realtime
realtime_window_minutes: 30
# Longest-edge pixel cap for real-time frames. 0 = upload the full-resolution
# camera frame (best for spotting small birds; ~400-500KB each). Set e.g. 1280
# to downscale and cut storage/bandwidth. The detector itself always sees its
# own 512px copy regardless of this.
realtime_max_image_dim: 0

log_level: INFO
